# Copiar como .env y completar antes de correr el backend en local.

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/opticapp

# Secreto para firmar JWT. Requerido: el servidor no arranca sin esto.
# Generar uno fuerte, por ejemplo: openssl rand -hex 32
JWT_SECRET=

# Contraseña del usuario admin inicial (solo se usa la primera vez que
# se inicializa la base, si el usuario "admin" todavía no existe).
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@opticapp.com

# ── Envío de emails ────────────────────────────────────────────────
# Hay dos transportes posibles y se elige el que esté configurado.
# Si no configurás ninguno, la app funciona igual: solo no manda avisos.

# Opción A — SMTP (por ejemplo, una casilla de Gmail). Tiene prioridad.
# Para Gmail hace falta:
#   1. Tener la verificación en dos pasos activada en la cuenta.
#   2. Generar una "Contraseña de aplicación" de 16 caracteres
#      (Cuenta de Google → Seguridad → Contraseñas de aplicaciones).
#      NO sirve la contraseña normal de la cuenta.
# Límite práctico de Gmail: ~500 destinatarios por día.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Opción B — Resend. Ojo: NO permite enviar desde @gmail.com,
# exige un dominio propio verificado (Settings → Domains).
RESEND_API_KEY=

# Remitente. Con SMTP de Gmail tiene que ser la misma casilla de SMTP_USER,
# porque Gmail rechaza remitentes que no controla.
# Ej: EMAIL_FROM=OpticApp <mioptica@gmail.com>
EMAIL_FROM=

APP_URL=http://localhost:5173

PORT=3001
NODE_ENV=development
